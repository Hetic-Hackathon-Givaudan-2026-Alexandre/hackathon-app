# Copié en .env.local à la création du dev container. Le .env.local n'est jamais commité.

# Base PostgreSQL du service db (compose.yaml)
DATABASE_URL=postgres://app:app@db:5432/app

# Fournisseur d'IA compatible OpenAI (voir docs/adr/0002-fournisseur-ia.md)
# Par défaut : Ollama sur votre machine, gratuit (ollama pull llama3.2:1b)
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=llama3.2:1b
AI_API_KEY=ollama

# Pour la démo avec Claude, remplacer les trois lignes ci-dessus par :
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_MODEL=claude-haiku-5-5
# AI_API_KEY=votre-cle-anthropic
